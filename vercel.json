{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/purchase/:id", "destination": "/purchase/[id]" },
    { "source": "/receipt/:id", "destination": "/receipt/[id]" }
  ]
}
